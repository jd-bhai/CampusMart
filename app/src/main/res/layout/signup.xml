<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F7FB">

    <!-- Back Button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="55dp">

        <ImageView
            android:id="@+id/back"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="18dp"
            android:src="@drawable/back_arrow_png"
            android:tint="#000000"/>

    </RelativeLayout>

    <!-- Heading -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="85dp"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create an account"
            android:textColor="#000000"
            android:textSize="25sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Provide your email and password to continue"
            android:textColor="#666666"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="6dp"/>

    </LinearLayout>

    <!-- Sign Up Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.9"
        android:orientation="vertical">

        <!-- White Form Panel -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="18dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="22dp">

            <!-- Email Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email Address"
                android:textColor="#000000"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="8dp"/>

            <!-- Email Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/email_png"
                    android:tint="#000000"
                    android:layout_marginEnd="10dp"/>

                <EditText
                    android:id="@+id/email"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="Enter your email"
                    android:inputType="textEmailAddress"
                    android:singleLine="true"
                    android:textSize="13sp"
                    android:paddingHorizontal="12dp"
                    android:background="@drawable/input_background"/>

            </LinearLayout>

            <!-- Password Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Password"
                android:textColor="#000000"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="8dp"/>

            <!-- Password Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/password_png"
                    android:tint="#000000"
                    android:layout_marginEnd="10dp"/>

                <EditText
                    android:id="@+id/password"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="Enter your password"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:textSize="13sp"
                    android:paddingHorizontal="12dp"
                    android:background="@drawable/input_background"/>

                <ImageView
                    android:id="@+id/togglePassword"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/eye"
                    android:tint="#000000"
                    android:layout_marginStart="8dp"/>

            </LinearLayout>

            <!-- Confirm Password Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Confirm Password"
                android:textColor="#000000"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="8dp"/>

            <!-- Confirm Password Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/password_png"
                    android:tint="#000000"
                    android:layout_marginEnd="10dp"/>

                <EditText
                    android:id="@+id/confirmPassword"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="Reenter your password"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:textSize="13sp"
                    android:paddingHorizontal="12dp"
                    android:background="@drawable/input_background"/>

                <ImageView
                    android:id="@+id/toggleConfirmPassword"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/eye"
                    android:tint="#000000"
                    android:layout_marginStart="8dp"/>

            </LinearLayout>

            <!-- Create Account -->
            <Button
                android:id="@+id/btnCreateAccount"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="18dp"
                android:text="Create account"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/button_background"/>

            <!-- Already Have Account -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="36dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Already have an account? "
                    android:textColor="#888888"
                    android:textStyle="bold"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/goToLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sign in"
                    android:textColor="#173B70"
                    android:textStyle="bold"
                    android:textSize="14sp"/>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>